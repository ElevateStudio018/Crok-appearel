---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import ProductCard from '../components/ProductCard.astro';
import ServiceRow from '../components/ServiceRow.astro';
import Photo from '../components/Photo.astro';
import Icon from '../components/Icon.astro';
import { products } from '../data/products';
import { photos } from '../data/photos';
import { site } from '../data/site';
import { breadcrumbSchema, itemListSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop' },
];

const schema = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'CORK 3 Collection',
    url: `${site.url}/shop`,
    isPartOf: { '@id': `${site.url}/#website` },
  },
  itemListSchema(products.map((p) => ({ name: p.name, path: `/product/${p.id}` }))),
];
---

<BaseLayout
  title="Shop CORK 3 – Baggy Ski Pants & Puffer Jacket"
  description="Shop the CORK 3 Collection: waterproof baggy ski pants and a baggy-fit down puffer jacket. Limited to 25 pieces per style. Pre-order now – ships before 24 December."
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <section class="container shop-head" aria-labelledby="shop-title">
    <div>
      <span class="eyebrow muted">Collection · Pre-order</span>
      <h1 id="shop-title" class="h1">CORK 3 Collection</h1>
    </div>
    <p class="lead">
      Our first collection, named after the cork 3 – the trick where it all started. Two pieces in black, made in a run of 25 each once the pre-order closes. Every order ships before {site.shipsBy}.
    </p>
  </section>

  <section class="container shop-grid-wrap" aria-label="Products">
    <p class="shop-count muted">{products.length} products</p>
    <div class="shop-grid">
      {products.map((product, i) => <ProductCard product={product} headingLevel="h2" eager={i < 2} />)}
    </div>
  </section>

  <ServiceRow />

  <section class="section shop-story" aria-labelledby="shop-story-title">
    <div class="container shop-story-grid">
      <div class="shop-story-copy">
        <span class="eyebrow muted">Made in small numbers</span>
        <h2 id="shop-story-title" class="h2">Pre-order, then we make it.</h2>
        <p class="muted">
          Each CORK 3 piece is produced in a limited run after the drop closes. You pay when you place your pre-order, and we ship before {site.shipsBy}. If production is delayed, we email you with a new date – and you can cancel for a full refund at any time before your order ships.
        </p>
        <a class="link-arrow" href="/policies#pre-order">Pre-order terms <Icon name="arrow-right" size={14} /></a>
      </div>
      <figure class="photo-frame shop-story-media">
        <Photo photo={photos.railFlip} sizes="(max-width: 860px) 100vw, 45vw" />
      </figure>
    </div>
  </section>
</BaseLayout>

<style>
  .shop-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: end;
    gap: 24px 64px;
    padding-block: clamp(24px, 4vw, 56px) clamp(32px, 4vw, 56px);
  }

  .shop-head .h1 {
    margin-top: 12px;
  }

  .shop-grid-wrap {
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  .shop-count {
    padding-block: 14px;
    margin-bottom: 20px;
    border-block: 1px solid var(--line);
    font-size: 0.8125rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .shop-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
  }

  .shop-story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 7vw, 112px);
  }

  .shop-story-copy {
    display: grid;
    justify-items: start;
    gap: 20px;
    max-width: 34em;
  }

  .shop-story-media {
    aspect-ratio: 4 / 5;
  }

  @media (max-width: 860px) {
    .shop-head,
    .shop-story-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .shop-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
