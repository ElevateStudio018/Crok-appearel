---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import ProductCard from '../components/ProductCard.astro';
import ServiceRow from '../components/ServiceRow.astro';
import Faq from '../components/Faq.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import Photo from '../components/Photo.astro';
import { products } from '../data/products';
import { photos } from '../data/photos';
import { faqs } from '../data/faq';
import { faqSchema, itemListSchema } from '../lib/schema';

const stats = [
  { value: '20,000 mm', label: 'Waterproofing', detail: 'CORK 3 Baggy Pants' },
  { value: '20,000 g', label: 'Breathability', detail: 'CORK 3 Baggy Pants' },
  { value: '90/10', label: 'Down fill', detail: 'CORK 3 Puff Jacket' },
  { value: '25', label: 'Pieces per style', detail: 'The full CORK 3 run' },
];

const editorial = [photos.railSpray, photos.railFlip, photos.snowfall];

const schema = [
  itemListSchema(products.map((p) => ({ name: p.name, path: `/product/${p.id}` }))),
  faqSchema(faqs),
];
---

<BaseLayout
  title="CORK – Baggy Ski Pants & Puffer Jackets from Sweden"
  rawTitle
  description="CORK is an independent freeski label from Uppsala, Sweden. Pre-order the CORK 3 Baggy Pants and Puff Jacket – limited to 25 pieces each, shipping before 24 December."
  schema={schema}
>
  <Hero />

  <section class="section" aria-labelledby="collection-title">
    <div class="container">
      <header class="section-head">
        <div>
          <span class="eyebrow muted">Shop</span>
          <h2 id="collection-title" class="h2">The CORK 3 Collection</h2>
        </div>
        <div class="section-head-aside">
          <p class="muted">Our first collection, named after the trick where it all started. Two pieces in black, made in a run of 25 each.</p>
          <a class="link-arrow" href="/shop">View collection <Icon name="arrow-right" size={14} /></a>
        </div>
      </header>

      <div class="product-grid">
        {products.map((product) => <ProductCard product={product} />)}
      </div>
    </div>
  </section>

  <section class="section section--dark stats" aria-labelledby="stats-title">
    <div class="container">
      <header class="stats-head">
        <span class="eyebrow">Specification</span>
        <h2 id="stats-title" class="h2">Built to be used.</h2>
      </header>
      <dl class="stats-grid">
        {
          stats.map((s) => (
            <div class="stat">
              <dt>
                <span class="stat-label">{s.label}</span>
                <span class="stat-detail">{s.detail}</span>
              </dt>
              <dd class="stat-value">{s.value}</dd>
            </div>
          ))
        }
      </dl>
    </div>
  </section>

  <section class="section story" aria-labelledby="story-title">
    <div class="container story-grid">
      <figure class="story-media photo-frame">
        <Photo photo={photos.railSlide} sizes="(max-width: 860px) 100vw, 50vw" />
      </figure>
      <div class="story-copy">
        <span class="eyebrow muted">Our story</span>
        <h2 id="story-title" class="h1">Not made to fit in.</h2>
        <p class="lead">
          CORK started in Sweden as a small circle of friends who skied, filmed and made their own clothes. No plan. No investors. Just pieces made for nights on the rail and days in the city.
        </p>
        <p class="muted">
          CORK 3 is our first collection, named after the cork 3 – the trick where it all started. Two pieces, made in small numbers once the pre-order closes.
        </p>
        <a class="link-arrow" href="/about">More about CORK <Icon name="arrow-right" size={14} /></a>
      </div>
    </div>
  </section>

  <section class="section section--dark editorial" aria-labelledby="editorial-title">
    <div class="container">
      <header class="editorial-head">
        <h2 id="editorial-title" class="h1">Nights on the rail.<br /> Days in the city.</h2>
        <a class="btn btn--light" href="/shop">Shop CORK 3</a>
      </header>
      <div class="editorial-grid">
        {
          editorial.map((photo) => (
            <figure class="photo-frame">
              <Photo photo={photo} widths={[400, 640, 960]} sizes="(max-width: 760px) 100vw, 33vw" />
            </figure>
          ))
        }
      </div>
    </div>
  </section>

  <ServiceRow />
  <Faq title="Pre-order questions" />
  <Newsletter />
</BaseLayout>

<style>
  .section-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px 48px;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .section-head .h2 {
    margin-top: 10px;
  }

  .section-head-aside {
    display: grid;
    justify-items: start;
    gap: 16px;
    max-width: 30em;
  }

  .product-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
  }

  .stats-head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }

  .stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid #2c2c2c;
  }

  .stat {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 18px;
    padding: 32px 24px 8px 0;
  }

  .stat + .stat {
    padding-left: 24px;
    border-left: 1px solid #2c2c2c;
  }

  .stat-value {
    margin: 0;
    white-space: nowrap;
    font-size: clamp(1.75rem, 3.1vw, 3rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .stat dt {
    display: grid;
    gap: 2px;
  }

  .stat-label {
    font-size: 0.8125rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .stat-detail {
    font-size: 0.875rem;
    color: var(--on-dark-muted);
  }

  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(32px, 7vw, 112px);
  }

  .story-media {
    aspect-ratio: 4 / 5;
  }

  .story-copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .editorial-head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: 24px;
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .editorial-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(12px, 1.6vw, 24px);
    align-items: start;
  }

  .editorial-grid figure {
    aspect-ratio: 3 / 4;
  }

  .editorial-grid figure:nth-child(2) {
    margin-top: clamp(32px, 6vw, 96px);
  }

  @media (max-width: 1000px) {
    .stats-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .stat:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .stat:nth-child(n + 3) {
      border-top: 1px solid #2c2c2c;
    }
  }

  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .product-grid {
      grid-template-columns: 1fr;
    }

    .editorial-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .editorial-grid figure:nth-child(2) {
      margin-top: 0;
    }

    .editorial-grid figure:first-child {
      grid-column: 1 / -1;
      aspect-ratio: 4 / 5;
    }
  }

  @media (max-width: 480px) {
    .stats-grid {
      grid-template-columns: 1fr;
    }

    .stat,
    .stat + .stat {
      padding: 24px 0 8px;
      border-left: 0;
    }

    .stat + .stat {
      border-top: 1px solid #2c2c2c;
    }
  }
</style>
