---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Contact', path: '/contact' },
];

const schema = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'ContactPage',
    name: 'Contact CORK',
    url: `${site.url}/contact`,
    about: { '@id': `${site.url}/#organization` },
  },
];
---

<BaseLayout
  title="Contact – Orders, Sizing & Questions"
  description="Questions about an order, sizing or anything else? Write to CORK and we will get back to you as soon as we can."
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <div class="container contact">
    <section class="contact-intro" aria-labelledby="contact-title">
      <span class="eyebrow muted">Customer service</span>
      <h1 id="contact-title" class="h1">Contact us</h1>
      <p class="lead">
        Questions about an order, sizing or anything else? Write to us here and we will get back to you as soon as we can. If it is about an order, have your order number ready.
      </p>

      <dl class="contact-facts">
        <div>
          <dt>Address</dt>
          <dd>
            {site.name}<br />
            {site.address.street}<br />
            {site.address.city}, {site.address.country}
          </dd>
        </div>
        <div>
          <dt>Orders &amp; returns</dt>
          <dd>
            Read our <a href="/policies#pre-order">pre-order</a>, <a href="/policies#shipping">shipping</a> and
            <a href="/policies#returns">returns</a> terms.
          </dd>
        </div>
      </dl>
    </section>

    <section class="contact-form-wrap" aria-label="Contact form">
      <form
        class="contact-form"
        name="contact"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-ajax-form
      >
        <input type="hidden" name="form-name" value="contact" />
        <p class="hp" aria-hidden="true">
          <label>Leave this empty <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>

        <div class="field">
          <label for="contact-name">Name</label>
          <input id="contact-name" class="input" name="name" required maxlength="100" autocomplete="name" />
        </div>
        <div class="field">
          <label for="contact-email">Email</label>
          <input id="contact-email" class="input" name="email" type="email" required maxlength="255" autocomplete="email" />
        </div>
        <div class="field">
          <label for="contact-order">Order number <span class="muted">(optional)</span></label>
          <input id="contact-order" class="input" name="order" maxlength="60" />
        </div>
        <div class="field">
          <label for="contact-topic">Topic</label>
          <select id="contact-topic" class="input" name="topic">
            <option>Order question</option>
            <option>Sizing &amp; fit</option>
            <option>Returns &amp; refunds</option>
            <option>Press &amp; collaborations</option>
            <option>Something else</option>
          </select>
        </div>
        <div class="field">
          <label for="contact-message">Message</label>
          <textarea id="contact-message" class="input" name="message" required maxlength="2000"></textarea>
        </div>

        <button class="btn" type="submit">Send message</button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <p class="muted small">
          We only use your details to answer your message. See our <a href="/policies#privacy">privacy policy</a>.
        </p>
      </form>
    </section>
  </div>
</BaseLayout>

<style>
  .contact {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 7vw, 112px);
    padding-block: clamp(24px, 4vw, 56px) clamp(64px, 9vw, 128px);
  }

  .contact-intro {
    display: grid;
    align-content: start;
    gap: 20px;
  }

  .contact-facts {
    display: grid;
    gap: 24px;
    margin-top: 16px;
    padding-top: 24px;
    border-top: 1px solid var(--line);
  }

  .contact-facts dt {
    margin-bottom: 6px;
    font-size: 0.75rem;
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact-facts dd {
    margin: 0;
    color: var(--ink-2);
  }

  .contact-form {
    display: grid;
    gap: 20px;
    padding: clamp(20px, 3vw, 40px);
    background: var(--surface);
  }

  .contact-form .btn {
    justify-self: start;
  }

  select.input {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 17px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 44px;
  }

  .small {
    font-size: 0.8125rem;
  }

  @media (max-width: 860px) {
    .contact {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initAjaxForms } from '../scripts/forms';
  initAjaxForms();
</script>
