---
import Product from '../../views/Product.astro';
import { getProducts, type Product as ProductData } from '../../data/products';

export function getStaticPaths() {
  return getProducts('en').map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: ProductData;
}
---

<Product lang="en" product={Astro.props.product} />
