---
import { Image, getImage } from 'astro:assets';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ProductCard from '../../components/ProductCard.astro';
import Icon from '../../components/Icon.astro';
import { products, type Product } from '../../data/products';
import { sizes } from '../../data/catalog';
import { site } from '../../data/site';
import { formatPrice } from '../../lib/format';
import { breadcrumbSchema, productSchema } from '../../lib/schema';

export function getStaticPaths() {
  return products.map((product) => ({ params: { id: product.id }, props: { product } }));
}

interface Props {
  product: Product;
}

const { product } = Astro.props;
const others = products.filter((p) => p.id !== product.id);
const price = formatPrice(product.price);
const available = !product.soldOut;
const ctaLabel = product.soldOut ? 'Sold out' : product.preOrder ? 'Pre-order' : 'Add to cart';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'Shop', path: '/shop' },
  { name: product.name, path: `/product/${product.id}` },
];

const schemaImages = await Promise.all(
  product.gallery.map(async (g) => new URL((await getImage({ src: g.src, width: 1024, format: 'jpg' })).src, site.url).toString()),
);
const schema = [breadcrumbSchema(crumbs), productSchema(product, schemaImages)];
---

<BaseLayout
  title={product.seoTitle}
  description={product.seoDescription}
  ogImage={`/og/${product.id}.jpg`}
  ogImageAlt={product.gallery[0].alt}
  ogType="product"
  schema={schema}
>
  <Fragment slot="head">
    <meta property="product:price:amount" content={String(product.price)} />
    <meta property="product:price:currency" content={site.currency} />
    <meta property="product:availability" content={product.soldOut ? 'out of stock' : product.preOrder ? 'preorder' : 'in stock'} />
    <meta property="product:brand" content={site.name} />
  </Fragment>

  <Breadcrumbs items={crumbs} />

  <div class="container pdp">
    <section class="gallery" aria-label={`${product.name} images`}>
      <ul role="list" class="gallery-track" data-gallery>
        {
          product.gallery.map((img, i) => (
            <li class="gallery-item" id={`image-${i + 1}`}>
              <Image
                src={img.src}
                alt={img.alt}
                widths={[480, 720, 1024]}
                sizes="(max-width: 960px) 100vw, 30vw"
                loading={i === 0 ? 'eager' : 'lazy'}
                fetchpriority={i === 0 ? 'high' : undefined}
              />
            </li>
          ))
        }
      </ul>
      <div class="gallery-dots" aria-hidden="true">
        {product.gallery.map((_, i) => <span data-dot={i} class:list={[{ active: i === 0 }]} />)}
      </div>
    </section>

    <section class="pdp-info" aria-labelledby="product-title">
      <div class="pdp-sticky">
        <a class="eyebrow muted pdp-collection" href="/shop">CORK 3 Collection</a>
        <h1 id="product-title" class="pdp-title">{product.name}</h1>

        <div class="pdp-price-row">
          <p class="pdp-price">{price}</p>
          {product.soldOut ? <span class="tag">Sold out</span> : product.preOrder && <span class="tag">Pre-order</span>}
          <span class="tag tag--outline">Limited to {product.editionLimit} pieces</span>
        </div>

        <p class="pdp-summary">{product.summary}</p>

        <form class="pdp-form" novalidate data-add-to-cart data-product-id={product.id} data-product-name={product.name}>
          <fieldset class="size-picker">
            <legend class="size-legend">
              <span>Size</span>
              <a href="#size-fit" data-open-details="size-fit">Size &amp; fit</a>
            </legend>
            <div class="size-options">
              {
                sizes.map((size) => (
                  <label class="size-option">
                    <input type="radio" name="size" value={size} required disabled={!available} />
                    <span>{size}</span>
                  </label>
                ))
              }
            </div>
            <p class="size-hint muted" data-size-hint>Colour: {product.colour}</p>
          </fieldset>

          <button class="btn btn--block pdp-cta" type="submit" disabled={!available}>
            {ctaLabel}
            {available && <span aria-hidden="true">·</span>}
            {available && <span>{price}</span>}
          </button>

          <p class="pdp-added" role="status" aria-live="polite" data-added hidden>
            <Icon name="check" size={18} />
            <span data-added-text>Added to your cart.</span>
            <a href="/cart">View cart &amp; check out</a>
          </p>
        </form>

        <ul role="list" class="pdp-perks">
          <li><Icon name="truck" size={18} /> Ships before {site.shipsBy} from {site.address.city}</li>
          <li><Icon name="return" size={18} /> 14-day right of withdrawal</li>
          <li><Icon name="lock" size={18} /> Secure checkout by Stripe</li>
        </ul>

        <div class="accordion pdp-accordion">
          <details open>
            <summary>Description</summary>
            <div class="accordion-body">
              {product.description.map((p) => <p>{p}</p>)}
            </div>
          </details>
          <details>
            <summary>Technical details</summary>
            <div class="accordion-body">
              <table class="spec-table">
                <tbody>
                  {
                    product.technicalDetails.map((d) => (
                      <tr>
                        <th scope="row">{d.label}</th>
                        <td>{d.value}</td>
                      </tr>
                    ))
                  }
                </tbody>
              </table>
            </div>
          </details>
          <details id="size-fit">
            <summary>Size &amp; fit</summary>
            <div class="accordion-body">
              <p>{product.fitNote}</p>
              {
                product.sizeGuide && (
                  <>
                    <table class="spec-table spec-table--grid">
                      <thead>
                        <tr>
                          {product.sizeGuide.columns.map((c) => (
                            <th scope="col">{c}</th>
                          ))}
                        </tr>
                      </thead>
                      <tbody>
                        {product.sizeGuide.rows.map((row) => (
                          <tr>
                            {row.map((cell, i) => (i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>))}
                          </tr>
                        ))}
                      </tbody>
                    </table>
                    <p class="muted small">{product.sizeGuide.note}</p>
                  </>
                )
              }
            </div>
          </details>
          <details>
            <summary>Shipping &amp; returns</summary>
            <div class="accordion-body">
              <p>
                Pre-order: you pay when you order and we ship before {site.shipsBy}. Shipping cost and delivery time are shown at checkout, and you get tracking by email when your order ships.
              </p>
              <p>
                You can cancel a pre-order for a full refund at any time before it ships. After delivery you have 14 days to withdraw from the purchase.
              </p>
              <p><a href="/policies">Read the full policies</a></p>
            </div>
          </details>
        </div>
      </div>
    </section>
  </div>

  {
    others.length > 0 && (
      <section class="section related" aria-labelledby="related-title">
        <div class="container">
          <h2 id="related-title" class="h2 related-title">Complete the look</h2>
          <div class="related-grid">
            {others.map((p) => (
              <ProductCard product={p} />
            ))}
          </div>
        </div>
      </section>
    )
  }
</BaseLayout>

<style>
  .pdp {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(340px, 1fr);
    gap: clamp(24px, 4vw, 72px);
    align-items: start;
    padding-bottom: clamp(56px, 8vw, 112px);
  }

  .gallery-track {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 8px;
  }

  .gallery-item {
    aspect-ratio: 1 / 1;
    background: var(--surface);
    overflow: hidden;
  }

  .gallery-item img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .gallery-dots {
    display: none;
  }

  .pdp-sticky {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 20px;
  }

  .pdp-collection {
    text-decoration: none;
  }

  .pdp-title {
    font-size: clamp(1.75rem, 2.6vw, 2.5rem);
    font-weight: 800;
    font-stretch: 120%;
    line-height: 1;
    letter-spacing: -0.01em;
    text-transform: uppercase;
  }

  .pdp-price-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 10px 12px;
  }

  .pdp-price {
    margin-right: 6px;
    font-size: 1.25rem;
    font-weight: 600;
  }

  .pdp-summary {
    color: var(--ink-2);
  }

  .pdp-form {
    display: grid;
    gap: 16px;
    padding-top: 4px;
  }

  .size-picker {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }

  .size-legend {
    display: flex;
    justify-content: space-between;
    width: 100%;
    margin-bottom: 10px;
    padding: 0;
    font-size: 0.75rem;
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .size-legend a {
    font-weight: 500;
    letter-spacing: 0.06em;
    color: var(--muted);
  }

  .size-options {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
  }

  .size-option {
    position: relative;
  }

  .size-option input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }

  .size-option span {
    display: grid;
    place-items: center;
    height: 52px;
    border: 1px solid #cfcfcf;
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: 0.06em;
    transition:
      border-color 0.15s var(--ease),
      background-color 0.15s var(--ease),
      color 0.15s var(--ease);
  }

  .size-option input:hover + span {
    border-color: var(--ink);
  }

  .size-option input:checked + span {
    background: var(--ink);
    border-color: var(--ink);
    color: var(--bg);
  }

  .size-option input:focus-visible + span {
    outline: 2px solid var(--focus);
    outline-offset: 2px;
  }

  .size-option input:disabled + span {
    color: #b0b0b0;
    background: var(--surface);
    border-color: var(--line);
    cursor: not-allowed;
  }

  .size-hint {
    margin-top: 10px;
    font-size: 0.875rem;
  }

  .size-hint[data-state='error'] {
    color: #b42318;
  }

  .pdp-cta {
    min-height: 56px;
  }

  .pdp-added {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    padding: 14px 16px;
    background: var(--surface);
    font-size: 0.9375rem;
  }

  .pdp-added a {
    margin-left: auto;
    font-weight: 600;
  }

  .pdp-perks {
    display: grid;
    gap: 10px;
    padding-block: 4px;
    font-size: 0.875rem;
    color: var(--ink-2);
  }

  .pdp-perks li {
    display: flex;
    align-items: center;
    gap: 10px;
  }

  .pdp-accordion {
    margin-top: 8px;
  }

  .small {
    font-size: 0.8125rem;
  }

  .related {
    border-top: 1px solid var(--line);
  }

  .related-title {
    margin-bottom: clamp(24px, 3vw, 40px);
  }

  .related-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(16px, 2vw, 32px);
  }

  @media (max-width: 960px) {
    .pdp {
      grid-template-columns: 1fr;
    }

    .gallery {
      margin-inline: calc(var(--gutter) * -1);
    }

    .gallery-track {
      display: flex;
      gap: 0;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
    }

    .gallery-track::-webkit-scrollbar {
      display: none;
    }

    .gallery-item {
      flex: 0 0 100%;
      scroll-snap-align: start;
    }

    .gallery-dots {
      display: flex;
      justify-content: center;
      gap: 8px;
      padding-top: 14px;
    }

    .gallery-dots span {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: #c8c8c8;
      transition: background-color 0.2s;
    }

    .gallery-dots span.active {
      background: var(--ink);
    }

    .pdp-sticky {
      position: static;
    }
  }

  @media (max-width: 560px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { addToCart } from '../../scripts/cart';

  // Gallery dots on the mobile carousel.
  const track = document.querySelector<HTMLElement>('[data-gallery]');
  const dots = document.querySelectorAll<HTMLElement>('[data-dot]');
  if (track && dots.length) {
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (!entry.isIntersecting) return;
          const index = Array.from(track.children).indexOf(entry.target);
          dots.forEach((d, i) => d.classList.toggle('active', i === index));
        });
      },
      { root: track, threshold: 0.6 },
    );
    Array.from(track.children).forEach((child) => io.observe(child));
  }

  // "Size & fit" link opens the accordion it points to.
  document.querySelectorAll<HTMLAnchorElement>('[data-open-details]').forEach((link) => {
    link.addEventListener('click', () => {
      const details = document.getElementById(link.dataset.openDetails!) as HTMLDetailsElement | null;
      if (details) details.open = true;
    });
  });

  // Add to cart.
  const form = document.querySelector<HTMLFormElement>('[data-add-to-cart]');
  if (form) {
    const hint = form.querySelector<HTMLElement>('[data-size-hint]');
    const added = form.querySelector<HTMLElement>('[data-added]');
    const addedText = form.querySelector<HTMLElement>('[data-added-text]');
    const defaultHint = hint?.textContent ?? '';

    form.addEventListener('change', () => {
      if (hint) {
        hint.textContent = defaultHint;
        delete hint.dataset.state;
      }
    });

    form.addEventListener('submit', (event) => {
      event.preventDefault();
      const size = new FormData(form).get('size');
      if (!size) {
        if (hint) {
          hint.textContent = 'Please select a size.';
          hint.dataset.state = 'error';
        }
        form.querySelector<HTMLInputElement>('input[name="size"]')?.focus();
        return;
      }
      addToCart(form.dataset.productId!, String(size));
      if (added && addedText) {
        addedText.textContent = `${form.dataset.productName} (${size}) added to your cart.`;
        added.hidden = false;
      }
    });
  }
</script>
