---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import Newsletter from '../components/Newsletter.astro';
import Icon from '../components/Icon.astro';
import { photos, photoCredits } from '../data/photos';
import { site } from '../data/site';
import { breadcrumbSchema } from '../lib/schema';

const crumbs = [
  { name: 'Home', path: '/' },
  { name: 'About', path: '/about' },
];

const principles = [
  {
    title: 'Independent',
    text: 'No investors, no outside plan. Just a small circle of friends making the clothes they want to ski and live in.',
  },
  {
    title: 'Made in small numbers',
    text: 'Each style is made in a limited run of 25, produced after the pre-order closes. Fewer pieces, made for the people who asked for them.',
  },
  {
    title: 'Built to be used',
    text: '20,000 mm waterproofing, 90/10 down, YKK zippers. Technical where it counts, baggy where it matters.',
  },
];

const schema = [
  breadcrumbSchema(crumbs),
  {
    '@context': 'https://schema.org',
    '@type': 'AboutPage',
    name: 'About CORK',
    url: `${site.url}/about`,
    about: { '@id': `${site.url}/#organization` },
  },
];
---

<BaseLayout
  title="About – Independent Freeski Outerwear from Sweden"
  description="CORK started in Sweden as a small circle of friends who skied, filmed and made their own clothes. Meet the independent label behind the CORK 3 Collection."
  schema={schema}
>
  <Breadcrumbs items={crumbs} />

  <section class="container about-intro" aria-labelledby="about-title">
    <span class="eyebrow muted">About</span>
    <h1 id="about-title" class="display">Not made<br /> to fit in.</h1>
  </section>

  <figure class="container about-hero">
    <div class="photo-frame about-hero-frame">
      <Photo photo={photos.powder} widths={[640, 960, 1440, 2000]} sizes="100vw" loading="eager" />
    </div>
  </figure>

  <section class="section container about-story" aria-labelledby="story-title">
    <h2 id="story-title" class="h2">Where it started</h2>
    <div class="prose about-prose">
      <p class="lead">
        CORK started in Sweden as a small circle of friends who skied, filmed and made their own clothes. No plan. No investors. Just pieces made for nights on the rail and days in the city.
      </p>
      <p>
        The name comes from the cork 3 – the trick where it all started – and so does the name of our first collection. CORK 3 is two pieces: a waterproof baggy pant and a glossy down puffer, both in black and both made in a run of 25.
      </p>
      <p>
        We are based in {site.address.city}, Sweden, and every order ships from there.
      </p>
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="principles-title">
    <div class="container">
      <h2 id="principles-title" class="h2 principles-title">What we stand for</h2>
      <ol role="list" class="principles">
        {
          principles.map((p, i) => (
            <li>
              <span class="principle-no">0{i + 1}</span>
              <h3 class="h3">{p.title}</h3>
              <p>{p.text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section container about-gallery" aria-label="Night sessions">
    <figure class="photo-frame">
      <Photo photo={photos.railSlide} sizes="(max-width: 760px) 100vw, 50vw" />
    </figure>
    <figure class="photo-frame">
      <Photo photo={photos.citySnow} sizes="(max-width: 760px) 100vw, 50vw" />
    </figure>
    <div class="about-cta">
      <h2 class="h2">The CORK 3 Collection is open for pre-order.</h2>
      <a class="btn" href="/shop">Shop the collection <Icon name="arrow-right" size={16} /></a>
    </div>
  </section>

  <section class="container credits" id="credits" aria-labelledby="credits-title">
    <h2 id="credits-title" class="h3">Photo credits</h2>
    <p class="muted">
      Product photography by CORK. Editorial photography from <a href="https://www.pexels.com" rel="noopener">Pexels</a>, used under the Pexels license and converted to black and white:
    </p>
    <ul role="list" class="credit-list">
      {
        photoCredits.map((c) => (
          <li>
            {c.credit} –{' '}
            {c.sources.map((s, i) => (
              <>
                {i > 0 && ', '}
                <a href={s} rel="noopener">
                  photo {i + 1}
                </a>
              </>
            ))}
          </li>
        ))
      }
    </ul>
  </section>

  <Newsletter />
</BaseLayout>

<style>
  .about-intro {
    display: grid;
    gap: 16px;
    padding-block: clamp(24px, 4vw, 56px) clamp(32px, 4vw, 56px);
  }

  .about-hero-frame {
    aspect-ratio: 21 / 9;
  }

  .about-story {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.5fr);
    gap: clamp(24px, 6vw, 96px);
  }

  .about-prose {
    color: var(--ink-2);
  }

  .principles-title {
    margin-bottom: clamp(32px, 5vw, 64px);
  }

  .principles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }

  .principles li {
    display: grid;
    align-content: start;
    gap: 14px;
    padding-top: 24px;
    border-top: 1px solid #2c2c2c;
  }

  .principles p {
    color: var(--on-dark-muted);
  }

  .principle-no {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    color: var(--on-dark-muted);
  }

  .about-gallery {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(12px, 2vw, 24px);
  }

  .about-gallery figure {
    aspect-ratio: 4 / 5;
  }

  .about-cta {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    padding-top: clamp(24px, 4vw, 48px);
  }

  .about-cta .h2 {
    max-width: 18em;
  }

  .credits {
    display: grid;
    gap: 12px;
    padding-bottom: clamp(56px, 8vw, 96px);
    font-size: 0.875rem;
  }

  .credit-list {
    display: grid;
    gap: 4px;
    color: var(--muted);
  }

  @media (max-width: 860px) {
    .about-story,
    .principles {
      grid-template-columns: 1fr;
    }

    .about-hero-frame {
      aspect-ratio: 4 / 3;
    }
  }

  @media (max-width: 560px) {
    .about-gallery {
      grid-template-columns: 1fr;
    }
  }
</style>
