---
import Icon from './Icon.astro';
import { site } from '../data/site';

const items = [
  { icon: 'snow', title: 'Limited runs', text: '25 pieces per style, made after the pre-order closes.' },
  { icon: 'truck', title: `Ships before ${site.shipsBy}`, text: `Sent from ${site.address.city} with tracking.` },
  { icon: 'return', title: '14-day returns', text: 'Right of withdrawal from the day you receive it.' },
  { icon: 'lock', title: 'Secure checkout', text: 'Payments handled by Stripe. We never see your card.' },
] as const;
---

<section class="service-row" aria-label="Why shop with CORK">
  <div class="container">
  <ul role="list" class="service-grid">
    {
      items.map((item) => (
        <li>
          <Icon name={item.icon} size={24} />
          <div>
            <h3 class="service-title">{item.title}</h3>
            <p class="service-text">{item.text}</p>
          </div>
        </li>
      ))
    }
  </ul>
  </div>
</section>

<style>
  .service-row {
    border-block: 1px solid var(--line);
  }

  .service-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .service-grid li {
    display: flex;
    gap: 14px;
    padding: 28px 24px 28px 0;
  }

  .service-grid li + li {
    padding-left: 24px;
    border-left: 1px solid var(--line);
  }

  .service-title {
    font-size: 0.8125rem;
    font-weight: 650;
    font-stretch: 112%;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .service-text {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  @media (max-width: 1000px) {
    .service-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .service-grid li:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }

    .service-grid li:nth-child(n + 3) {
      border-top: 1px solid var(--line);
    }
  }

  @media (max-width: 560px) {
    .service-grid {
      grid-template-columns: 1fr;
    }

    .service-grid li,
    .service-grid li + li {
      padding: 20px 0;
      border-left: 0;
    }

    .service-grid li + li {
      border-top: 1px solid var(--line);
    }
  }
</style>
