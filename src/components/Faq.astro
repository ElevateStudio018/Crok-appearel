---
import { faqs } from '../data/faq';
import { localizePath, type Lang } from '../i18n';
import { fill, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].faq;
const more = fill(t.more, { contact: localizePath('/contact', lang), policies: localizePath('/policies', lang) });
---

<section class="section faq" aria-labelledby="faq-title">
  <div class="container faq-grid">
    <div class="faq-head">
      <span class="eyebrow muted">{t.eyebrow}</span>
      <h2 id="faq-title" class="h2 faq-title">{t.title}</h2>
      <p class="muted faq-more" set:html={more} />
    </div>
    <div class="accordion">
      {
        faqs[lang].map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="accordion-body">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  .faq-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(32px, 6vw, 96px);
  }

  /* Sized to the column, so long words such as "förbeställning" fit. */
  .faq-head {
    container-type: inline-size;
  }

  .faq-title {
    margin-top: 12px;
    font-size: min(3rem, 8.6cqi);
  }

  .faq-more {
    margin-top: 20px;
  }

  @media (max-width: 860px) {
    .faq-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
