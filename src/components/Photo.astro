---
import { Picture } from 'astro:assets';
import type { Photo } from '../data/photos';
import type { Lang } from '../i18n';

interface Props {
  photo: Photo;
  lang: Lang;
  sizes: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Decorative use: empty alt text. */
  decorative?: boolean;
}

const { photo, lang, sizes, widths = [480, 720, 960, 1280], loading = 'lazy', class: className, decorative = false } = Astro.props;
---

<Picture
  src={photo.src}
  alt={decorative ? '' : photo.alt[lang]}
  formats={['avif', 'webp']}
  widths={widths}
  sizes={sizes}
  quality={68}
  loading={loading}
  class={className}
/>
