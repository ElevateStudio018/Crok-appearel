---
import Photo from './Photo.astro';
import SignupForm from './SignupForm.astro';
import { photos } from '../data/photos';
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].newsletter;
---

<section class="newsletter on-dark" id="newsletter" aria-labelledby="newsletter-title">
  <Photo photo={photos.starlitSlope} lang={lang} decorative widths={[640, 1024, 1600]} sizes="100vw" class="newsletter-bg" />
  <div class="container newsletter-inner">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 id="newsletter-title" class="h2">{t.title}</h2>
    <p class="lead">{t.text}</p>
    <SignupForm lang={lang} id="newsletter" />
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(88px, 12vw, 168px);
  }

  .newsletter :global(.newsletter-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0.5;
  }

  .newsletter::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 14, 14, 0.2), rgba(14, 14, 14, 0.75));
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .newsletter-inner .lead {
    max-width: 34em;
    color: #cfcfca;
  }

  .newsletter-inner :global(.signup) {
    margin-top: 12px;
  }
</style>
