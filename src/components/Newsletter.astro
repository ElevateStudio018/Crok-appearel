---
import SignupForm from './SignupForm.astro';
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].newsletter;
---

<section class="newsletter on-dark" id="newsletter" aria-labelledby="newsletter-title">
  <div class="container newsletter-inner">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 id="newsletter-title" class="h2">{t.title}</h2>
    <p class="lead">{t.text}</p>
    <SignupForm lang={lang} id="newsletter" />
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(88px, 12vw, 168px);
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .newsletter-inner .lead {
    max-width: 34em;
    color: #cfcfca;
  }

  .newsletter-inner :global(.signup) {
    margin-top: 12px;
  }
</style>
