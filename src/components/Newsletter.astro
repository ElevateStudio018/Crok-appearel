---
import Photo from './Photo.astro';
import { photos } from '../data/photos';
import { localizePath, type Lang } from '../i18n';
import { fill, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].newsletter;
const f = ui[lang].forms;
---

<section class="newsletter on-dark" id="newsletter" aria-labelledby="newsletter-title">
  <Photo photo={photos.starlitSlope} lang={lang} decorative widths={[640, 1024, 1600]} sizes="100vw" class="newsletter-bg" />
  <div class="container newsletter-inner">
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 id="newsletter-title" class="h2">{t.title}</h2>
    <p class="lead">{t.text}</p>

    <form
      class="newsletter-form"
      name="newsletter"
      method="POST"
      data-netlify="true"
      netlify-honeypot="bot-field"
      data-ajax-form
      data-msg-sending={f.sending}
      data-msg-success={t.success}
      data-msg-error={f.error}
    >
      <input type="hidden" name="form-name" value="newsletter" />
      <input type="hidden" name="language" value={lang} />
      <p class="hp" aria-hidden="true">
        <label>{f.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
      </p>
      <label class="visually-hidden" for="newsletter-email">{t.email}</label>
      <input
        id="newsletter-email"
        class="input"
        type="email"
        name="email"
        required
        autocomplete="email"
        placeholder={t.email}
      />
      <button class="btn btn--light" type="submit">{t.submit}</button>
      <p class="form-status" role="status" aria-live="polite" data-form-status></p>
    </form>
    <p class="newsletter-note" set:html={fill(t.note, { privacy: localizePath('/policies#privacy', lang) })} />
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(88px, 12vw, 168px);
  }

  .newsletter :global(.newsletter-bg) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 30%;
    opacity: 0.5;
  }

  .newsletter::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(14, 14, 14, 0.2), rgba(14, 14, 14, 0.75));
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .newsletter-inner .lead {
    max-width: 34em;
    color: #cfcfca;
  }

  .newsletter-form {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    width: min(100%, 520px);
    margin-top: 12px;
  }

  .newsletter-form .input {
    background: rgba(255, 255, 255, 0.08);
    border-color: rgba(244, 243, 239, 0.45);
    color: var(--on-dark);
  }

  .newsletter-form .input::placeholder {
    color: #b9b9b4;
  }

  .newsletter-form .input:focus {
    border-color: var(--on-dark);
    box-shadow: 0 0 0 1px var(--on-dark);
  }

  .newsletter-form .form-status {
    grid-column: 1 / -1;
    margin-top: 12px;
    min-height: 1.5em;
  }

  .newsletter-form .form-status[data-state='error'] {
    color: #ffb4a8;
  }

  .newsletter-note {
    font-size: 0.8125rem;
    color: var(--on-dark-muted);
  }

  @media (max-width: 520px) {
    .newsletter-form {
      grid-template-columns: 1fr;
      gap: 10px;
    }
  }
</style>

<script>
  import { initAjaxForms } from '../scripts/forms';
  initAjaxForms();
</script>
