---
import SignupForm from './SignupForm.astro';
import mascotUrl from '../assets/brand/cork-mascot.svg?url';
import type { Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].newsletter;
---

<section class="newsletter on-dark" id="newsletter" aria-labelledby="newsletter-title">
  <div class="container newsletter-inner">
    <!-- the CORK mascot hopping back and forth above the sign-up -->
    <div class="nl-cork" aria-hidden="true">
      <div class="nl-cork-x">
        <span class="nl-cork-shadow"></span>
        <div class="nl-cork-y">
          <div class="nl-cork-flip">
            <img src={mascotUrl} alt="" width="46" height="72" loading="lazy" decoding="async" />
          </div>
        </div>
      </div>
    </div>
    <span class="eyebrow">{t.eyebrow}</span>
    <h2 id="newsletter-title" class="h2">{t.title}</h2>
    <p class="lead">{t.text}</p>
    <SignupForm lang={lang} id="newsletter" />
  </div>
</section>

<style>
  .newsletter {
    position: relative;
    overflow: hidden;
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(88px, 12vw, 168px);
  }

  .newsletter-inner {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 18px;
    text-align: center;
  }

  .newsletter-inner .lead {
    max-width: 34em;
    color: #cfcfca;
  }

  .newsletter-inner :global(.signup) {
    margin-top: 12px;
  }

  .nl-cork {
    position: relative;
    width: min(320px, 100%);
    height: 112px;
    margin-bottom: 4px;
  }

  /* 4 s: eight hops across to the right, turn, eight hops back */
  .nl-cork-x {
    position: absolute;
    left: 50%;
    bottom: 8px;
    animation: nl-cork-x 4s linear infinite;
  }

  .nl-cork-y {
    position: absolute;
    left: -23px;
    bottom: 0;
    width: 46px;
    animation: nl-cork-y 0.5s infinite;
  }

  .nl-cork-flip {
    transform-origin: 50% 100%;
    animation:
      nl-cork-flip 4s steps(1) infinite,
      nl-cork-squash 0.5s infinite;
  }

  .nl-cork-flip img {
    display: block;
    width: 46px;
    height: auto;
  }

  .nl-cork-shadow {
    position: absolute;
    left: -26px;
    bottom: -5px;
    width: 52px;
    height: 10px;
    border-radius: 50%;
    background: radial-gradient(closest-side, rgb(244 243 239 / 0.26), rgb(244 243 239 / 0));
    animation: nl-cork-shadow 0.5s infinite;
  }

  @keyframes nl-cork-x {
    0%,
    100% {
      transform: translateX(-120px);
    }
    50% {
      transform: translateX(120px);
    }
  }

  @keyframes nl-cork-y {
    0%,
    100% {
      transform: translateY(0);
      animation-timing-function: cubic-bezier(0.2, 0.75, 0.35, 1);
    }
    50% {
      transform: translateY(-34px);
      animation-timing-function: cubic-bezier(0.65, 0, 0.8, 0.25);
    }
  }

  /* faces the way it hops */
  @keyframes nl-cork-flip {
    0% {
      scale: 1 1;
    }
    50% {
      scale: -1 1;
    }
  }

  @keyframes nl-cork-squash {
    0%,
    100% {
      transform: scale(1.12, 0.86);
    }
    14% {
      transform: scale(0.92, 1.08);
    }
    30%,
    86% {
      transform: scale(1, 1);
    }
  }

  @keyframes nl-cork-shadow {
    0%,
    100% {
      transform: scaleX(1.1);
      opacity: 1;
    }
    50% {
      transform: scaleX(0.6);
      opacity: 0.45;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nl-cork-x,
    .nl-cork-y,
    .nl-cork-flip,
    .nl-cork-shadow {
      animation: none;
    }
  }
</style>
