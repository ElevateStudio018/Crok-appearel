---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { photos } from '../data/photos';
import { localizePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].home;

// The three photos CORK picked, as a mosaic: one tall, two stacked.
const tiles = [
  { photo: photos.railSlide, class: 'tile-main', widths: [360, 540, 720, 960, 1280], sizes: '(min-width: 861px) 30vw, 60vw' },
  { photo: photos.streetRail, class: 'tile-top', widths: [240, 360, 540, 720, 960], sizes: '(min-width: 861px) 30vw, 40vw' },
  { photo: photos.swissTrick, class: 'tile-bottom', widths: [240, 360, 540, 720, 960], sizes: '(min-width: 861px) 30vw, 40vw' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-copy">
    <span class="eyebrow">{t.heroEyebrow}</span>
    <h1 id="hero-title" class="hero-title" set:html={t.heroTitle} />
    <p class="hero-text">{t.heroText}</p>
    <div class="hero-actions">
      <a class="btn btn--light" href={localizePath('/shop', lang)}>{t.heroShop} <Icon name="arrow-right" size={16} /></a>
      <a class="btn btn--outline-light" href={localizePath('/about', lang)}>{t.heroStory}</a>
    </div>
  </div>

  <div class="hero-media">
    {
      tiles.map((tile) => (
        <div class:list={['hero-tile', tile.class]}>
          <Picture
            src={tile.photo.src}
            alt={tile.photo.alt[lang]}
            formats={['avif', 'webp']}
            widths={tile.widths}
            sizes={tile.sizes}
            quality={70}
            loading="eager"
            fetchpriority={tile.class === 'tile-main' ? 'high' : 'auto'}
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Full screen: the three photos fill the screen below the header, the copy sits on top. */
  .hero {
    position: relative;
    display: flex;
    align-items: flex-end;
    min-height: calc(100svh - var(--header-h) - 34px);
    background: var(--dark);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4px;
  }

  /* darkens the bottom left so the copy reads on any photo */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(0deg, rgb(10 10 10 / 0.88) 0%, rgb(10 10 10 / 0.45) 38%, rgb(10 10 10 / 0) 65%),
      linear-gradient(90deg, rgb(10 10 10 / 0.5) 0%, rgb(10 10 10 / 0) 55%);
    pointer-events: none;
  }

  .hero-tile {
    position: relative;
    overflow: hidden;
    background: #1a1a1a;
  }

  .tile-main {
    grid-row: 1 / span 2;
  }

  .hero-tile :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-main :global(img) {
    object-position: 45% 40%;
  }

  .tile-top :global(img) {
    object-position: 50% 30%;
  }

  .tile-bottom :global(img) {
    object-position: 62% 50%;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    width: min(100%, 900px);
    padding: clamp(48px, 6vw, 96px) var(--gutter);
  }

  .hero-title {
    font-size: clamp(2.25rem, 4.6vw, 5.25rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-text {
    max-width: 28em;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.55;
    color: #e2e2dd;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: calc(100svh - var(--header-h) - 56px);
    }

    .hero-media {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 3px;
    }

    .hero-media::after {
      background: linear-gradient(0deg, rgb(10 10 10 / 0.92) 0%, rgb(10 10 10 / 0.6) 40%, rgb(10 10 10 / 0) 70%);
    }

    .hero-copy {
      gap: 18px;
      padding-block: 32px 40px;
    }

    .hero-title {
      font-size: clamp(2rem, 9.4vw, 4rem);
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
