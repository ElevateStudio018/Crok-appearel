---
import { Picture } from 'astro:assets';
import Icon from './Icon.astro';
import { photos } from '../data/photos';
import { localizePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].home;
---

<section class="hero" aria-labelledby="hero-title">
  <div class="hero-media">
    <Picture
      src={photos.hero.src}
      alt={photos.hero.alt[lang]}
      formats={['avif', 'webp']}
      widths={[480, 720, 960, 1280, 1600]}
      sizes="(min-width: 861px) 50vw, 100vw"
      quality={70}
      loading="eager"
      fetchpriority="high"
      class:list={[photos.hero.mono && 'is-mono']}
    />
  </div>

  <div class="hero-copy">
    <span class="eyebrow">{t.heroEyebrow}</span>
    <h1 id="hero-title" class="hero-title" set:html={t.heroTitle} />
    <p class="hero-text">{t.heroText}</p>
    <div class="hero-actions">
      <a class="btn btn--light" href={localizePath('/shop', lang)}>{t.heroShop} <Icon name="arrow-right" size={16} /></a>
      <a class="btn btn--outline-light" href={localizePath('/about', lang)}>{t.heroStory}</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    min-height: min(calc(100svh - var(--header-h) - 34px), 900px);
    background: var(--dark);
    color: var(--on-dark);
  }

  .hero-media {
    position: relative;
    grid-column: 2;
    grid-row: 1;
    overflow: hidden;
  }

  .hero-media :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 35%;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    grid-column: 1;
    grid-row: 1;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    align-items: flex-start;
    gap: 22px;
    padding: clamp(48px, 6vw, 96px) var(--gutter);
  }

  .hero-title {
    font-size: clamp(2.75rem, 4.3vw, 4.75rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 0.92;
    letter-spacing: -0.02em;
    text-transform: uppercase;
  }

  .hero-text {
    max-width: 28em;
    font-size: clamp(1rem, 1.25vw, 1.1875rem);
    line-height: 1.55;
    color: #d6d6d1;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 6px;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      min-height: calc(100svh - var(--header-h) - 34px);
    }

    .hero-media {
      position: absolute;
      inset: 0;
      grid-column: auto;
    }

    .hero-media::after {
      content: '';
      position: absolute;
      inset: 0;
      background: linear-gradient(0deg, rgba(10, 10, 10, 0.9) 0%, rgba(10, 10, 10, 0.4) 45%, rgba(10, 10, 10, 0) 75%);
    }

    .hero-media :global(img) {
      object-position: 50% 25%;
    }

    .hero-copy {
      grid-column: 1;
      padding-block: 40px;
    }

    .hero-title {
      font-size: clamp(2rem, 9.4vw, 4rem);
    }

    .hero-actions {
      width: 100%;
    }

    .hero-actions .btn {
      flex: 1 1 100%;
    }
  }
</style>
