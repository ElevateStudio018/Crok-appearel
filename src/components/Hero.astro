---
import { Picture } from 'astro:assets';
import Logo from './Logo.astro';
import { nav } from '../data/site';
import { photos } from '../data/photos';
import { localizePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].home;
const title = t.heroTitle.replace(/<br\s*\/?>/g, '');

// The three photos CORK picked, as a mosaic: one tall, two stacked.
const tiles = [
  { photo: photos.railSlide, class: 'tile-main', widths: [360, 540, 720, 960, 1280], sizes: '(min-width: 861px) 30vw, 60vw' },
  { photo: photos.streetRail, class: 'tile-top', widths: [240, 360, 540, 720, 960], sizes: '(min-width: 861px) 30vw, 40vw' },
  { photo: photos.swissTrick, class: 'tile-bottom', widths: [240, 360, 540, 720, 960], sizes: '(min-width: 861px) 30vw, 40vw' },
];
---

<section class="hero" aria-labelledby="hero-title">
  <!-- capeesh-style landing: the wordmark with the menu as a list underneath -->
  <div class="hero-copy">
    <h1 id="hero-title" class="hero-brand">
      <span class="visually-hidden">CORK – {title}</span>
      <Logo />
    </h1>
    <nav aria-label={ui[lang].meta.home}>
      <ul role="list" class="hero-nav">
        {
          nav[lang].map((item) => (
            <li>
              <a href={localizePath(item.href, lang)}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>
    <a class="hero-note" href={localizePath('/shop', lang)}>{t.heroEyebrow}</a>
  </div>

  <div class="hero-media">
    {
      tiles.map((tile) => (
        <div class:list={['hero-tile', tile.class]}>
          <Picture
            src={tile.photo.src}
            alt={tile.photo.alt[lang]}
            formats={['avif', 'webp']}
            widths={tile.widths}
            sizes={tile.sizes}
            quality={70}
            loading="eager"
            fetchpriority={tile.class === 'tile-main' ? 'high' : 'auto'}
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  /* Full screen: the three photos fill the screen below the header, the copy sits on top. */
  .hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: calc(100svh - var(--header-h) - 34px);
    background: var(--dark);
    color: var(--on-dark);
    overflow: hidden;
  }

  .hero-media {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: 4px;
  }

  /* evens out the photos so the centred menu reads on all of them */
  .hero-media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at center, rgb(10 10 10 / 0.62) 0%, rgb(10 10 10 / 0.38) 60%, rgb(10 10 10 / 0.2) 100%);
    pointer-events: none;
  }

  .hero-tile {
    position: relative;
    overflow: hidden;
    background: #1a1a1a;
  }

  .tile-main {
    grid-row: 1 / span 2;
  }

  .hero-tile :global(picture) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .hero-tile :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .tile-main :global(img) {
    object-position: 45% 40%;
  }

  .tile-top :global(img) {
    object-position: 50% 30%;
  }

  .tile-bottom :global(img) {
    object-position: 62% 50%;
  }

  .hero-copy {
    position: relative;
    z-index: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    width: 100%;
    padding: 56px var(--gutter);
    text-align: center;
  }

  .hero-brand {
    height: clamp(30px, 3.4vw, 40px);
    color: var(--on-dark);
  }

  .hero-nav {
    display: grid;
    gap: 2px;
  }

  .hero-nav a,
  .hero-note {
    display: inline-block;
    padding: 6px 10px;
    color: var(--on-dark);
    font-size: 1.0625rem;
    text-decoration: none;
  }

  .hero-nav a:hover,
  .hero-nav a:focus-visible,
  .hero-note:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .hero-note {
    font-size: 0.875rem;
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  @media (max-width: 860px) {
    .hero {
      min-height: calc(100svh - var(--header-h) - 56px);
    }

    .hero-media {
      grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
      gap: 3px;
    }

    .hero-nav a {
      padding: 9px 12px;
    }
  }
</style>
