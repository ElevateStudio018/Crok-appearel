---
import Photo from './Photo.astro';
import Icon from './Icon.astro';
import { photos as allPhotos, type Photo as PhotoData } from '../data/photos';
import { localizePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
  /** Unique id prefix when the block appears on a page with other headings. */
  id?: string;
  showLink?: boolean;
  /** Three photos make a collage (one tall, two stacked); one photo is shown on its own. */
  photos?: PhotoData[];
}

const {
  lang,
  id = 'story',
  showLink = true,
  photos = [allPhotos.railSlide, allPhotos.streetRail, allPhotos.swissTrick],
} = Astro.props;
const single = photos.length === 1;
const t = ui[lang].story;
---

<section class="section story" aria-labelledby={`${id}-title`}>
  <div class="container story-grid">
    <div class="story-copy">
      <span class="eyebrow muted">{t.eyebrow}</span>
      <h2 id={`${id}-title`} class="h1">{t.title}</h2>
      <div class="story-text">
        {t.paragraphs.map((p, i) => <p class:list={[i === 0 ? 'lead' : 'story-p']}>{p}</p>)}
      </div>
      {
        showLink && (
          <a class="link-arrow" href={localizePath('/about', lang)}>
            {t.link} <Icon name="arrow-right" size={14} />
          </a>
        )
      }
    </div>

    {
      single ? (
        <figure class="photo-frame story-single">
          <Photo photo={photos[0]} lang={lang} widths={[480, 720, 960, 1280]} sizes="(max-width: 860px) 100vw, 55vw" />
        </figure>
      ) : (
        <div class="story-collage" role="group" aria-label={t.imagesLabel}>
          {photos.slice(0, 3).map((photo, i) => (
            <figure class:list={['photo-frame', ['collage-tall', 'collage-top', 'collage-bottom'][i]]}>
              <Photo
                photo={photo}
                lang={lang}
                widths={i === 0 ? [400, 640, 960, 1280] : [400, 640, 960]}
                sizes="(max-width: 860px) 50vw, 30vw"
              />
            </figure>
          ))}
        </div>
      )
    }
  </div>
</section>

<style>
  .story-grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    align-items: center;
    gap: clamp(32px, 6vw, 96px);
  }

  .story-copy {
    display: grid;
    justify-items: start;
    gap: 22px;
  }

  .story-text {
    display: grid;
    gap: 14px;
    max-width: 34em;
  }

  .story-p {
    color: var(--ink-2);
  }

  .story-collage {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    grid-template-rows: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(8px, 1.2vw, 16px);
    aspect-ratio: 4 / 3;
  }

  .story-collage figure {
    margin: 0;
    min-height: 0;
  }

  .collage-tall {
    grid-row: 1 / span 2;
  }

  .story-single {
    margin: 0;
    aspect-ratio: 1 / 1;
  }

  .story-single :global(img) {
    object-position: 50% 45%;
  }

  .collage-bottom :global(img) {
    object-position: 60% 55%;
  }

  @media (max-width: 860px) {
    .story-grid {
      grid-template-columns: 1fr;
    }

    .story-collage {
      aspect-ratio: 1 / 1;
    }

    .story-single {
      aspect-ratio: 4 / 5;
    }
  }
</style>
