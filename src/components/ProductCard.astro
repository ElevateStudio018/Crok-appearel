---
import { Image } from 'astro:assets';
import type { Product } from '../data/products';
import { formatPrice } from '../lib/format';

interface Props {
  product: Product;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { product, headingLevel = 'h3', eager = false } = Astro.props;
const Heading = headingLevel;
const [primary, secondary] = product.gallery;
const href = `/product/${product.id}`;
---

<article class="product-card">
  <a href={href} class="card-media" tabindex="-1" aria-hidden="true">
    <Image
      src={primary.src}
      alt=""
      widths={[480, 720, 1024]}
      sizes="(max-width: 700px) 100vw, 50vw"
      loading={eager ? 'eager' : 'lazy'}
      class="card-img card-img--primary"
    />
    {
      secondary && (
        <Image
          src={secondary.src}
          alt=""
          widths={[480, 720, 1024]}
          sizes="(max-width: 700px) 100vw, 50vw"
          loading="lazy"
          class="card-img card-img--secondary"
        />
      )
    }
    <span class="card-badges">
      {product.soldOut ? <span class="tag">Sold out</span> : product.preOrder && <span class="tag">Pre-order</span>}
      <span class="tag tag--outline">{product.editionLimit} pieces</span>
    </span>
  </a>
  <div class="card-body">
    <div>
      <Heading class="card-title"><a href={href}>{product.name}</a></Heading>
      <p class="card-meta">{product.category} · {product.colour}</p>
    </div>
    <p class="card-price">{formatPrice(product.price)}</p>
  </div>
</article>

<style>
  .product-card {
    position: relative;
  }

  .card-media {
    position: relative;
    display: block;
    aspect-ratio: 1 / 1;
    overflow: hidden;
    background: var(--surface);
  }

  .card-img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition:
      opacity 0.5s var(--ease),
      transform 0.8s var(--ease);
  }

  .card-img--secondary {
    opacity: 0;
  }

  @media (hover: hover) {
    .product-card:hover .card-img--secondary {
      opacity: 1;
    }

    .product-card:hover .card-img--primary {
      transform: scale(1.02);
    }
  }

  .card-badges {
    position: absolute;
    top: 16px;
    left: 16px;
    display: flex;
    gap: 6px;
  }

  .card-body {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 16px;
    padding-top: 16px;
  }

  .card-title {
    font-size: 1rem;
    font-weight: 650;
    font-stretch: 112%;
    line-height: 1.3;
    text-transform: uppercase;
    letter-spacing: 0.01em;
  }

  .card-title a {
    text-decoration: none;
  }

  /* Make the whole card clickable via the title link. */
  .card-title a::after {
    content: '';
    position: absolute;
    inset: 0;
  }

  .card-meta {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .card-price {
    font-size: 1rem;
    font-weight: 600;
    white-space: nowrap;
  }
</style>
