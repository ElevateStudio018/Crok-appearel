---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { footerNav, site } from '../data/site';
import { localizePath, type Lang } from '../i18n';
import { fill, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang];
const href = (path: string) => localizePath(path, lang);

const socials = (
  [
    ['instagram', 'Instagram', site.social.instagram],
    ['youtube', 'YouTube', site.social.youtube],
    ['tiktok', 'TikTok', site.social.tiktok],
  ] as const
).filter(([, , url]) => url);

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-top">
      <div class="footer-brand">
        <a href={href('/')} class="footer-logo" aria-label={t.meta.homeLabel}><Logo /></a>
        <p>{fill(t.footer.blurb, { city: site.address.city })}</p>
        <address>
          {site.name} · {site.address.street} · {site.address.city}, {site.address.country[lang]}
        </address>
        {
          socials.length > 0 && (
            <ul role="list" class="socials">
              {socials.map(([icon, label, url]) => (
                <li>
                  <a href={url} target="_blank" rel="noopener" aria-label={label}>
                    <Icon name={icon} size={20} />
                  </a>
                </li>
              ))}
            </ul>
          )
        }
      </div>

      {
        footerNav[lang].map((group) => (
          <nav class="footer-col" aria-label={group.title}>
            <h2 class="footer-heading">{group.title}</h2>
            <ul role="list">
              {group.links.map((link) => (
                <li>
                  <a href={href(link.href)}>{link.label}</a>
                </li>
              ))}
            </ul>
          </nav>
        ))
      }

    </div>

    <div class="footer-bottom">
      <p>© {year} {site.name}. {t.footer.rights}</p>
      <p>{t.footer.prices}</p>
      <p>{t.footer.photography} <a href={href('/about#credits')}>{t.footer.photographers}</a></p>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    background: var(--dark);
    color: var(--on-dark);
    padding-block: clamp(56px, 8vw, 96px) 32px;
    font-size: 0.9375rem;
  }

  .footer-top {
    display: grid;
    grid-template-columns: minmax(260px, 1.6fr) repeat(4, minmax(140px, 1fr));
    gap: 40px;
  }

  .footer-logo {
    display: block;
    height: 30px;
    width: max-content;
    color: var(--on-dark);
  }

  .footer-brand p {
    margin-top: 20px;
    max-width: 30em;
    color: var(--on-dark-muted);
  }

  .socials {
    display: flex;
    gap: 16px;
    margin-top: 24px;
  }

  .socials a {
    color: var(--on-dark-muted);
  }

  .socials a:hover {
    color: var(--on-dark);
  }

  .footer-heading {
    margin-bottom: 16px;
    font-size: 0.75rem;
    font-weight: 600;
    font-stretch: 110%;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--on-dark);
  }

  .footer-col ul {
    display: grid;
    gap: 10px;
  }

  .footer-col a {
    color: var(--on-dark-muted);
    text-decoration: none;
  }

  .footer-col a:hover {
    color: var(--on-dark);
  }

  address {
    margin-top: 16px;
    font-style: normal;
    font-size: 0.875rem;
    color: var(--on-dark-muted);
    line-height: 1.7;
  }

  .footer-bottom {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 12px 32px;
    margin-top: clamp(48px, 7vw, 88px);
    padding-top: 24px;
    border-top: 1px solid #2a2a2a;
    font-size: 0.8125rem;
    color: var(--on-dark-muted);
  }

  .footer-bottom a {
    color: var(--on-dark);
  }

  @media (max-width: 1080px) {
    .footer-top {
      grid-template-columns: repeat(3, 1fr);
    }

    .footer-brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 600px) {
    .footer-top {
      grid-template-columns: 1fr 1fr;
      gap: 36px 24px;
    }
  }
</style>
