---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import { photos } from '../data/photos';
import { instagramUrl, riders } from '../data/team';
import { breadcrumbSchema, teamSchema, webPageSchema } from '../lib/schema';
import { localizePath, type Lang } from '../i18n';
import { fill, ui } from '../i18n/ui';
import puffLabel from '../assets/products/cork-3-puff-label.jpg';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].team;
const f = ui[lang].forms;
const href = (path: string) => localizePath(path, lang);

const crumbs = [
  { name: ui[lang].meta.home, path: href('/') },
  { name: t.crumb, path: href('/team') },
];
const riderNames = new Intl.ListFormat(lang === 'sv' ? 'sv' : 'en-GB', { type: 'conjunction' }).format(riders.map((r) => r.name));
const description = fill(t.description, { riders: riderNames });
const schema = [
  breadcrumbSchema(crumbs),
  webPageSchema('AboutPage', t.heading, href('/team'), lang),
  teamSchema(riders, t.riderRole),
];

const rolePhotos = [photos.railSlide, photos.swissTrick];
---

<BaseLayout lang={lang} title={t.title} description={description} schema={schema}>
  <Breadcrumbs lang={lang} items={crumbs} />

  <section class="container team-hero" aria-labelledby="team-title">
    <div class="team-hero-copy">
      <span class="eyebrow muted">{t.eyebrow}</span>
      <h1 id="team-title" class="display">{t.heading}</h1>
      <p class="lead">{t.lead}</p>
      <a class="btn" href="#apply">{t.applyTitle}</a>
    </div>
    <figure class="photo-frame team-hero-media">
      <Photo photo={photos.streetRail} lang={lang} widths={[640, 960, 1440, 1920]} sizes="(max-width: 860px) 100vw, 55vw" loading="eager" />
    </figure>
  </section>

  <section class="section container riders" aria-labelledby="riders-title">
    <header class="riders-head">
      <span class="eyebrow muted">{t.ridersEyebrow}</span>
      <h2 id="riders-title" class="h1">{t.ridersTitle}</h2>
      <p class="muted">{t.ridersText}</p>
    </header>
    <ol role="list" class="rider-list">
      {
        riders.map((rider, i) => (
          <li class="rider">
            <span class="rider-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="rider-name">{rider.name}</h3>
            {rider.instagram ? (
              <a class="rider-role" href={instagramUrl(rider.instagram)} rel="noopener" target="_blank">
                @{rider.instagram}
              </a>
            ) : (
              <span class="rider-role">{t.riderRole}</span>
            )}
          </li>
        ))
      }
    </ol>
    <p class="riders-apply">
      {t.ridersApply} <a href="#apply">{t.applyTitle}</a>
    </p>
  </section>

  <section class="section section--dark" aria-labelledby="roles-title">
    <div class="container">
      <h2 id="roles-title" class="h2 roles-title">{t.rolesTitle}</h2>
      <ul role="list" class="roles">
        {
          t.roles.map((role, i) => (
            <li class="role">
              <figure class="photo-frame role-media">
                {rolePhotos[i] ? (
                  <Photo photo={rolePhotos[i]} lang={lang} widths={[400, 640, 960]} sizes="(max-width: 860px) 100vw, 33vw" />
                ) : (
                  <Image src={puffLabel} alt={ui[lang].backstage.details[3].text} widths={[400, 640, 960]} sizes="(max-width: 860px) 100vw, 33vw" />
                )}
              </figure>
              <h3 class="h3">{role.title}</h3>
              <p>{role.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>


  <section class="section section--surface" id="apply" aria-labelledby="apply-title">
    <div class="container apply">
      <div class="apply-copy">
        <span class="eyebrow muted">{t.applyEyebrow}</span>
        <h2 id="apply-title" class="h2">{t.applyTitle}</h2>
        <p class="lead">{t.applyLead}</p>
      </div>
      <form
        class="apply-form"
        name="team"
        method="POST"
        data-netlify="true"
        netlify-honeypot="bot-field"
        data-ajax-form
        data-msg-sending={f.sending}
        data-msg-success={t.success}
        data-msg-error={f.error}
      >
        <input type="hidden" name="form-name" value="team" />
        <input type="hidden" name="language" value={lang} />
        <p class="hp" aria-hidden="true">
          <label>{f.honeypot} <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="field-row">
          <div class="field">
            <label for="team-name">{t.name}</label>
            <input id="team-name" class="input" name="name" required maxlength="100" autocomplete="name" />
          </div>
          <div class="field">
            <label for="team-email">{t.email}</label>
            <input id="team-email" class="input" name="email" type="email" required maxlength="255" autocomplete="email" />
          </div>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="team-role">{t.role}</label>
            <select id="team-role" class="input" name="role">
              {t.roleOptions.map((o) => <option>{o}</option>)}
            </select>
          </div>
          <div class="field">
            <label for="team-handle">{t.handle} <span class="muted">{t.optional}</span></label>
            <input id="team-handle" class="input" name="handle" maxlength="100" />
          </div>
        </div>
        <div class="field">
          <label for="team-home">{t.home}</label>
          <input id="team-home" class="input" name="home" maxlength="100" />
        </div>
        <div class="field">
          <label for="team-link">{t.link}</label>
          <input id="team-link" class="input" name="link" type="url" required maxlength="500" placeholder="https://" />
        </div>
        <div class="field">
          <label for="team-message">{t.message} <span class="muted">{t.optional}</span></label>
          <textarea id="team-message" class="input" name="message" maxlength="2000"></textarea>
        </div>
        <button class="btn" type="submit">{t.submit}</button>
        <p class="form-status" role="status" aria-live="polite" data-form-status></p>
        <p class="muted small" set:html={fill(t.privacy, { privacy: href('/policies#privacy') })} />
      </form>
    </div>
  </section>
</BaseLayout>

<style>
  .team-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    align-items: end;
    gap: clamp(24px, 5vw, 72px);
    padding-block: clamp(16px, 3vw, 40px) var(--section);
  }

  .team-hero-copy {
    display: grid;
    justify-items: start;
    gap: 20px;
    container-type: inline-size;
  }

  /* Sized to the column, so "Gänget." fits. */
  .team-hero .display {
    font-size: min(7rem, 15cqi);
  }

  .team-hero-media {
    aspect-ratio: 3 / 2;
  }

  .roles-title {
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .roles {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 40px);
  }

  .role {
    display: grid;
    align-content: start;
    gap: 14px;
  }

  .role p {
    color: var(--on-dark-muted);
  }

  .role-media {
    aspect-ratio: 4 / 5;
    margin-bottom: 6px;
  }

  .role-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Follows the hero directly, which already has bottom padding. */
  .riders {
    padding-top: 0;
  }

  .riders-head {
    display: grid;
    gap: 12px;
    margin-bottom: clamp(28px, 4vw, 56px);
  }

  .rider-list {
    border-top: 1px solid var(--line);
  }

  .rider {
    display: grid;
    grid-template-columns: 3.5rem minmax(0, 1fr) auto;
    align-items: baseline;
    gap: 16px;
    padding-block: clamp(18px, 2.4vw, 30px);
    border-bottom: 1px solid var(--line);
  }

  .rider-no {
    font-size: 0.8125rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    color: var(--muted);
  }

  .rider-name {
    font-size: clamp(1.625rem, 4.6vw, 4rem);
    font-weight: 800;
    font-stretch: 125%;
    line-height: 1;
    letter-spacing: -0.015em;
    text-transform: uppercase;
  }

  .rider-role {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--muted);
  }

  a.rider-role:hover {
    color: var(--ink);
  }

  .riders-apply {
    margin-top: clamp(20px, 3vw, 32px);
    color: var(--muted);
  }

  .apply {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.2fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }

  .apply-copy {
    display: grid;
    gap: 16px;
  }

  .apply-form {
    display: grid;
    gap: 20px;
    padding: clamp(20px, 3vw, 40px);
    background: var(--bg);
  }

  .apply-form .btn {
    justify-self: start;
  }

  .field-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 20px;
  }

  select.input {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, currentColor 50%), linear-gradient(135deg, currentColor 50%, transparent 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 17px) 50%;
    background-size: 5px 5px;
    background-repeat: no-repeat;
    padding-right: 44px;
  }

  .small {
    font-size: 0.8125rem;
  }

  @media (max-width: 860px) {
    .team-hero,
    .roles,
    .apply {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .rider {
      grid-template-columns: 2rem minmax(0, 1fr);
      row-gap: 6px;
    }

    .rider-role {
      grid-column: 2;
    }

    .rider-name {
      font-size: clamp(1.25rem, 6.6vw, 1.625rem);
    }

    .field-row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { initAjaxForms } from '../scripts/forms';
  initAjaxForms();
</script>
