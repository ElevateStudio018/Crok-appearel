---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Photo from '../components/Photo.astro';
import SignupForm from '../components/SignupForm.astro';
import { photos } from '../data/photos';
import { breadcrumbSchema, faqSchema, webPageSchema } from '../lib/schema';
import { localizePath, type Lang } from '../i18n';
import { ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].mailing;
const href = (path: string) => localizePath(path, lang);

const crumbs = [
  { name: ui[lang].meta.home, path: href('/') },
  { name: t.crumb, path: href('/mailing-list') },
];
const schema = [breadcrumbSchema(crumbs), webPageSchema('WebPage', t.heading, href('/mailing-list'), lang), faqSchema(t.faqs)];
---

<BaseLayout lang={lang} title={t.title} description={t.description} schema={schema}>
  <Breadcrumbs lang={lang} items={crumbs} />

  <section class="container ml-hero" aria-labelledby="ml-title">
    <figure class="photo-frame ml-media">
      <Photo photo={photos.idreSunset} lang={lang} widths={[480, 720, 960, 1440]} sizes="(max-width: 860px) 100vw, 50vw" loading="eager" />
    </figure>
    <div class="ml-copy">
      <span class="eyebrow muted">{t.eyebrow}</span>
      <h1 id="ml-title" class="display">{t.heading}</h1>
      <p class="lead">{t.lead}</p>
      <SignupForm lang={lang} id="mailing" tone="light" />
    </div>
  </section>

  <section class="section section--dark" aria-labelledby="benefits-title">
    <div class="container">
      <h2 id="benefits-title" class="h2 ml-section-title">{t.benefitsTitle}</h2>
      <ul role="list" class="benefits">
        {
          t.benefits.map((b) => (
            <li>
              <h3 class="h3">{b.title}</h3>
              <p>{b.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="section container ml-faq" aria-labelledby="ml-faq-title">
    <h2 id="ml-faq-title" class="h2">{t.faqTitle}</h2>
    <div class="accordion">
      {
        t.faqs.map((f, i) => (
          <details open={i === 0}>
            <summary>{f.q}</summary>
            <div class="accordion-body">
              <p>{f.a}</p>
            </div>
          </details>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .ml-hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    align-items: center;
    gap: clamp(28px, 6vw, 96px);
    padding-block: clamp(16px, 3vw, 40px) var(--section);
  }

  .ml-media {
    aspect-ratio: 4 / 5;
  }

  .ml-copy {
    display: grid;
    justify-items: start;
    gap: 20px;
  }

  .ml-copy :global(.signup) {
    margin-top: 8px;
  }

  .ml-section-title {
    margin-bottom: clamp(28px, 4vw, 48px);
  }

  .benefits {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(20px, 3vw, 48px);
  }

  .benefits li {
    display: grid;
    align-content: start;
    gap: 12px;
    padding-top: 22px;
    border-top: 1px solid #2c2c2c;
  }

  .benefits p {
    color: var(--on-dark-muted);
  }

  .ml-faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.4fr);
    gap: clamp(28px, 6vw, 96px);
  }

  @media (max-width: 860px) {
    .ml-hero,
    .benefits,
    .ml-faq {
      grid-template-columns: 1fr;
    }

    .ml-media {
      aspect-ratio: 4 / 3;
    }
  }
</style>
