---
import { getImage } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
import { getProducts } from '../data/products';
import { site } from '../data/site';
import { localizePath, type Lang } from '../i18n';
import { fill, ui } from '../i18n/ui';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = ui[lang].cart;
const date = site.shipsBy[lang];

// Minimal catalog and strings for rendering the cart in the browser.
const cartData = {
  lang,
  strings: {
    sizeLabel: t.sizeLabel,
    preOrder: ui[lang].product.preOrderTag,
    remove: t.remove,
    decrease: t.decrease,
    increase: t.increase,
    quantity: t.quantity,
    notConfigured: t.notConfigured,
    failed: t.failed,
  },
  products: await Promise.all(
    getProducts(lang).map(async (p) => ({
      id: p.id,
      name: p.name,
      colour: p.colour,
      price: p.price,
      preOrder: p.preOrder,
      href: localizePath(`/product/${p.id}`, lang),
      image: (await getImage({ src: p.gallery[0].src, width: 240, format: 'webp' })).src,
    })),
  ),
};
---

<BaseLayout lang={lang} title={t.title} description={t.description} noindex>
  <div class="container cart-page">
    <header class="cart-head">
      <h1 class="h1">{t.heading}</h1>
    </header>

    <div class="cart-layout" data-cart-root hidden>
      <section aria-label={t.items}>
        <ul role="list" class="cart-lines" data-cart-lines></ul>
      </section>

      <aside class="cart-summary" aria-labelledby="summary-title">
        <h2 id="summary-title" class="h3">{t.summary}</h2>
        <dl class="summary-rows">
          <div>
            <dt>{t.subtotal}</dt>
            <dd data-cart-subtotal>0</dd>
          </div>
          <div>
            <dt>{t.shipping}</dt>
            <dd>{t.shippingAtCheckout}</dd>
          </div>
        </dl>
        <div class="summary-total">
          <span>{t.total}</span>
          <span data-cart-total>0</span>
        </div>
        <button class="btn btn--block" type="button" data-checkout>
          {t.checkout} <Icon name="arrow-right" size={16} />
        </button>
        <p class="form-status" role="alert" data-checkout-error></p>
        <ul role="list" class="summary-notes">
          <li><Icon name="truck" size={16} /> {fill(t.noteShips, { date })}</li>
          <li><Icon name="return" size={16} /> {t.noteCancel}</li>
          <li><Icon name="lock" size={16} /> {t.noteSecure}</li>
        </ul>
      </aside>
    </div>

    <div class="cart-empty" data-cart-empty hidden>
      <p class="lead">{t.empty}</p>
      <a class="btn" href={localizePath('/shop', lang)}>{t.emptyCta}</a>
    </div>

    <noscript>
      <p class="lead">{t.noscript}</p>
    </noscript>
  </div>

  <script type="application/json" id="cart-data" set:html={JSON.stringify(cartData)} />
</BaseLayout>

<style>
  .cart-page {
    padding-block: clamp(32px, 5vw, 72px) clamp(64px, 9vw, 128px);
    min-height: 60vh;
  }

  .cart-head {
    margin-bottom: clamp(24px, 4vw, 48px);
  }

  .cart-layout {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(300px, 1fr);
    gap: clamp(24px, 5vw, 80px);
    align-items: start;
  }

  .cart-layout[hidden],
  .cart-empty[hidden] {
    display: none;
  }

  .cart-lines {
    border-top: 1px solid var(--line);
  }

  .cart-lines :global(li) {
    display: grid;
    grid-template-columns: 120px minmax(0, 1fr) auto;
    gap: 20px;
    padding-block: 20px;
    border-bottom: 1px solid var(--line);
  }

  .cart-lines :global(.line-img) {
    display: block;
    aspect-ratio: 1;
    background: var(--surface);
  }

  .cart-lines :global(.line-img img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-lines :global(.line-name) {
    font-weight: 650;
    font-stretch: 112%;
    text-transform: uppercase;
    text-decoration: none;
  }

  .cart-lines :global(.line-meta) {
    margin-top: 4px;
    font-size: 0.875rem;
    color: var(--muted);
  }

  .cart-lines :global(.line-controls) {
    display: flex;
    align-items: center;
    gap: 16px;
    margin-top: 16px;
  }

  .cart-lines :global(.qty) {
    display: inline-flex;
    align-items: center;
    border: 1px solid #cfcfcf;
  }

  .cart-lines :global(.qty button) {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .cart-lines :global(.qty button:disabled) {
    opacity: 0.35;
    cursor: not-allowed;
  }

  .cart-lines :global(.qty output) {
    min-width: 28px;
    text-align: center;
    font-weight: 600;
  }

  .cart-lines :global(.line-remove) {
    border: 0;
    background: none;
    padding: 0;
    font-size: 0.8125rem;
    color: var(--muted);
    text-decoration: underline;
    text-underline-offset: 0.2em;
    cursor: pointer;
  }

  .cart-lines :global(.line-price) {
    font-weight: 600;
    white-space: nowrap;
  }

  .cart-summary {
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: grid;
    gap: 18px;
    padding: clamp(20px, 3vw, 32px);
    background: var(--surface);
  }

  .summary-rows {
    display: grid;
    gap: 10px;
    margin: 0;
  }

  .summary-rows div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    font-size: 0.9375rem;
  }

  .summary-rows dd {
    margin: 0;
    color: var(--ink-2);
  }

  .summary-total {
    display: flex;
    justify-content: space-between;
    padding-top: 16px;
    border-top: 1px solid #d8d8d8;
    font-size: 1.125rem;
    font-weight: 700;
  }

  .summary-notes {
    display: grid;
    gap: 8px;
    font-size: 0.8125rem;
    color: var(--ink-2);
  }

  .summary-notes li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .cart-empty {
    display: grid;
    justify-items: start;
    gap: 24px;
    padding-block: 24px;
  }

  @media (max-width: 860px) {
    .cart-layout {
      grid-template-columns: 1fr;
    }

    .cart-summary {
      position: static;
    }
  }

  @media (max-width: 520px) {
    .cart-lines :global(li) {
      grid-template-columns: 88px minmax(0, 1fr);
    }

    .cart-lines :global(.line-price) {
      grid-column: 2;
    }
  }
</style>

<script>
  import { getCart, setQty, removeFromCart, onCartChange, MAX_QTY, type CartLine } from '../scripts/cart';

  interface CartData {
    lang: 'en' | 'sv';
    strings: Record<'sizeLabel' | 'preOrder' | 'remove' | 'decrease' | 'increase' | 'quantity' | 'notConfigured' | 'failed', string>;
    products: { id: string; name: string; colour: string; price: number; preOrder: boolean; href: string; image: string }[];
  }

  const { lang, strings: s, products: catalog }: CartData = JSON.parse(document.getElementById('cart-data')?.textContent || '{}');
  const sek = new Intl.NumberFormat('sv-SE', { maximumFractionDigits: 0 });
  const money = (n: number) => `${sek.format(n).replace(/ /g, ' ')} ${lang === 'sv' ? 'kr' : 'SEK'}`;

  const root = document.querySelector<HTMLElement>('[data-cart-root]')!;
  const empty = document.querySelector<HTMLElement>('[data-cart-empty]')!;
  const list = document.querySelector<HTMLElement>('[data-cart-lines]')!;
  const subtotalEl = document.querySelector<HTMLElement>('[data-cart-subtotal]')!;
  const totalEl = document.querySelector<HTMLElement>('[data-cart-total]')!;
  const checkoutBtn = document.querySelector<HTMLButtonElement>('[data-checkout]')!;
  const errorEl = document.querySelector<HTMLElement>('[data-checkout-error]')!;

  const el = <K extends keyof HTMLElementTagNameMap>(tag: K, props: Partial<HTMLElementTagNameMap[K]> = {}, children: (Node | string)[] = []) => {
    const node = Object.assign(document.createElement(tag), props);
    node.append(...children);
    return node;
  };

  const render = (lines: CartLine[]) => {
    const known = lines.filter((l) => catalog.some((c) => c.id === l.id));
    root.hidden = known.length === 0;
    empty.hidden = known.length > 0;
    list.replaceChildren();

    let subtotal = 0;
    for (const line of known) {
      const item = catalog.find((c) => c.id === line.id)!;
      const lineTotal = item.price * line.qty;
      subtotal += lineTotal;

      const img = el('img', { src: item.image, alt: '', width: 240, height: 240, loading: 'lazy' });
      const minus = el('button', { type: 'button', textContent: '−', disabled: line.qty <= 1 });
      minus.setAttribute('aria-label', s.decrease.replace('{name}', item.name));
      const plus = el('button', { type: 'button', textContent: '+', disabled: line.qty >= MAX_QTY });
      plus.setAttribute('aria-label', s.increase.replace('{name}', item.name));
      const qty = el('output', { textContent: String(line.qty) });
      qty.setAttribute('aria-label', s.quantity);
      const remove = el('button', { type: 'button', className: 'line-remove', textContent: s.remove });

      minus.addEventListener('click', () => setQty(line.id, line.size, line.qty - 1));
      plus.addEventListener('click', () => setQty(line.id, line.size, line.qty + 1));
      remove.addEventListener('click', () => removeFromCart(line.id, line.size));

      const meta = [item.colour, `${s.sizeLabel} ${line.size}`, item.preOrder ? s.preOrder : ''].filter(Boolean).join(' · ');
      list.append(
        el('li', {}, [
          el('a', { href: item.href, className: 'line-img', tabIndex: -1 }, [img]),
          el('div', {}, [
            el('a', { href: item.href, className: 'line-name', textContent: item.name }),
            el('p', { className: 'line-meta', textContent: meta }),
            el('div', { className: 'line-controls' }, [el('div', { className: 'qty' }, [minus, qty, plus]), remove]),
          ]),
          el('p', { className: 'line-price', textContent: money(lineTotal) }),
        ]),
      );
    }

    subtotalEl.textContent = money(subtotal);
    totalEl.textContent = money(subtotal);
  };

  render(getCart());
  onCartChange(render);

  checkoutBtn.addEventListener('click', async () => {
    errorEl.textContent = '';
    delete errorEl.dataset.state;
    checkoutBtn.disabled = true;
    try {
      const res = await fetch('/api/checkout', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ items: getCart(), lang }),
      });
      const data = await res.json().catch(() => ({}));
      // 404: no checkout function where the site is hosted (e.g. the githack preview).
      if (res.status === 404) throw new Error('checkout_not_configured');
      if (!res.ok || !data.url) throw new Error(data.error || 'checkout_failed');
      window.location.href = data.url;
    } catch (err) {
      const code = err instanceof Error ? err.message : '';
      errorEl.dataset.state = 'error';
      errorEl.textContent = code === 'checkout_not_configured' ? s.notConfigured : s.failed;
      checkoutBtn.disabled = false;
    }
  });
</script>
